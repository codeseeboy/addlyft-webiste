# ---------------------------------------------------------------------------
# Addlyft — environment
# Copy to .env.local for development, or set these in your hosting provider.
# Every one of them is optional; the site builds and runs without any of them.
# ---------------------------------------------------------------------------

# Canonical origin. Drives metadata, sitemap.xml, robots.txt and JSON-LD.
# Set this in production — otherwise it falls back to https://addlyft.com.
NEXT_PUBLIC_SITE_URL=https://addlyft.com

# Public contact address shown on /contact and in the privacy summary.
NEXT_PUBLIC_CONTACT_EMAIL=hello@addlyft.com

# --- Contact form delivery -------------------------------------------------
# Pick ONE. With neither set, submissions are written to the server log and
# the visitor still gets a success response.

# 1) Post the submission as JSON (Slack incoming webhook, Zapier, a CRM):
# CONTACT_WEBHOOK_URL=

# 2) Or send email through Resend:
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=hello@addlyft.com
# CONTACT_FROM_EMAIL=Addlyft <notifications@addlyft.com>
